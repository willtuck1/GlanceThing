# Copy to .env for local builds. Never commit a real .env.

# GitHub repo (owner/name) the app downloads the client zip and update info from.
# Defaults to the "repository" field in package.json.
GT_REPO=

# Optional: Google OAuth desktop client baked into the build (used from M2 on).
# Leave empty to make users enter their own in Settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
